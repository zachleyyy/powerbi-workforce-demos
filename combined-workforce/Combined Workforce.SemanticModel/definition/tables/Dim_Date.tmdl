table Dim_Date

	column Date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: Date

		variation Variation
			isDefault
			relationship: c44445db-cbe2-4093-bdf8-672a7a466166
			defaultHierarchy: LocalDateTable_cd33d62a-b65f-4c73-8f81-8d1df0edd8b7.'Date Hierarchy'

	column DateKey
		dataType: int64
		formatString: 0
		summarizeBy: count
		sourceColumn: DateKey

	column Day
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: Day

	column DayName
		dataType: string
		summarizeBy: none
		sourceColumn: DayName

	column WeekStart
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: WeekStart

		variation Variation
			isDefault
			relationship: d158115d-81e2-4fc4-96d0-20e4119a2896
			defaultHierarchy: LocalDateTable_640ed47f-d184-4302-8310-075c38576bf3.'Date Hierarchy'

	column WeekEnd
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: WeekEnd

		variation Variation
			isDefault
			relationship: 919e7318-e064-4630-a3a0-d274652fe698
			defaultHierarchy: LocalDateTable_904e3a43-8777-4291-b985-1728b429c34c.'Date Hierarchy'

	column WeekLabel
		dataType: string
		summarizeBy: none
		sourceColumn: WeekLabel
		sortByColumn: WeekStart

	column ISOWeek
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: ISOWeek

	column MonthStart
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: MonthStart

		variation Variation
			isDefault
			relationship: 06ce39f8-02ff-4bb4-8448-2a400d765dc2
			defaultHierarchy: LocalDateTable_e89ceddc-3b96-46a1-95c2-46342e9f01f0.'Date Hierarchy'

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName
		sortByColumn: 'Fiscal Month Sort'

	column MonthLabel
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: MonthLabel

		variation Variation
			isDefault
			relationship: ec2737f3-1d70-4823-90de-30d992652415
			defaultHierarchy: LocalDateTable_086dc462-3bac-43bd-aa8e-ea6ccda94441.'Date Hierarchy'

	column CalendarQuarter
		dataType: string
		summarizeBy: none
		sourceColumn: CalendarQuarter

	column CalendarYear
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: CalendarYear

	column FiscalWeekNumber
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: FiscalWeekNumber

	column FiscalWeekLabel
		dataType: string
		summarizeBy: none
		sourceColumn: FiscalWeekLabel
		sortByColumn: WeekStart

	column FiscalQuarter
		dataType: string
		summarizeBy: none
		sourceColumn: FiscalQuarter

	column FiscalYear
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: FiscalYear

	column 'Fiscal Month Sort' =
			
			MOD ( MONTH ( Dim_Date[MonthStart] ) + 5, 12 ) + 1
		dataType: int64
		formatString: 0
		summarizeBy: sum

	column 'Current Week Filter' =
			
			VAR DemoNow = DATE ( 2026, 6, 30 )
			VAR DemoToday = DATE ( YEAR ( DemoNow ), MONTH ( DemoNow ), DAY ( DemoNow ) )
			RETURN
			    IF (
			        Dim_Date[WeekStart] <= DemoToday
			            && Dim_Date[WeekEnd] >= DemoToday,
			        "Demo week",
			        "Other week"
			    )
		dataType: string
		summarizeBy: none


