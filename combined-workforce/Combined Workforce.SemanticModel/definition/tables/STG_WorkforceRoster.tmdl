table STG_WorkforceRoster

	column PersonNumber
		dataType: string
		summarizeBy: none
		sourceColumn: PersonNumber

	column LegalFullName
		dataType: string
		summarizeBy: none
		sourceColumn: LegalFullName

	column HireDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: HireDate

		variation Variation
			isDefault
			relationship: 82674fdb-0658-450b-93e9-9b82c91bbd02
			defaultHierarchy: LocalDateTable_69fc62d4-cd06-4c98-832f-2bc594aacfbf.'Date Hierarchy'

