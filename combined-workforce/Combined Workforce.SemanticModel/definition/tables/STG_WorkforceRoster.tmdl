		dataType: string
		summarizeBy: none
		sourceColumn: Bus Route

	column Carplate
		dataType: string
		summarizeBy: none
		sourceColumn: Carplate

	column 'Source.Name'
		dataType: string
		summarizeBy: none
		sourceColumn: Source.Name

	column 'Age Band' =
			
			SWITCH(
			    TRUE(),
			    STG_WorkforceRoster[Age] < 18, "<18",
			    STG_WorkforceRoster[Age] <= 23, "18-23",
			    STG_WorkforceRoster[Age] <= 29, "24-29",
			    STG_WorkforceRoster[Age] <= 35, "30-35",
			    STG_WorkforceRoster[Age] <= 41, "36-41",
			    STG_WorkforceRoster[Age] <= 47, "42-47",
			    STG_WorkforceRoster[Age] <= 53, "48-53",
			    STG_WorkforceRoster[Age] <= 59, "54-59",
			    "60+"
			)
		summarizeBy: none
		sortByColumn: 'Age Band Sort'

	column 'Age Band Sort' =
			
			SWITCH(
			    TRUE(),
			    STG_WorkforceRoster[Age] < 18, 1,
			    STG_WorkforceRoster[Age] <= 23, 2,
			    STG_WorkforceRoster[Age] <= 29, 3,
			    STG_WorkforceRoster[Age] <= 35, 4,
			    STG_WorkforceRoster[Age] <= 41, 5,
			    STG_WorkforceRoster[Age] <= 47, 6,
			    STG_WorkforceRoster[Age] <= 53, 7,
			   STG_WorkforceRoster[Age] <= 59, 8,
			    9
			)
		formatString: 0
		summarizeBy: sum

	column TenureBand =
			
			VAR Days =
			    DATEDIFF(STG_WorkforceRoster[HireDate], DATE ( 2026, 6, 30 ), DAY)
			VAR Months =
			    DATEDIFF(STG_WorkforceRoster[HireDate], DATE ( 2026, 6, 30 ), MONTH)
			RETURN
			SWITCH(
			    TRUE(),
			    Days < 7, "<1 Week",
			    Days < 14, "1-2 Weeks",
			    Days < 21, "2-3 Weeks",
			    Days < 31, "<1 Month",
			
			    Months < 3, "1-3 Months",
			    Months < 6, "3-6 Months",
			    Months < 9, "6-9 Months",
			    Months < 12, "9-12 Months",
			
			    Months < 24, "1-2 Years",
			    Months < 36, "2-3 Years",
			    Months < 60, "3-5 Years",
			    Months < 120, "5-10 Years",
			
			    "10+ Years"
			)
		summarizeBy: none
		sortByColumn: 'TenureBand Sort'

	column 'TenureBand Sort' =
			
			VAR Days =
			    DATEDIFF(STG_WorkforceRoster[HireDate], DATE ( 2026, 6, 30 ), DAY)
			VAR Months =
			    DATEDIFF(STG_WorkforceRoster[HireDate], DATE ( 2026, 6, 30 ), MONTH)
			RETURN
			SWITCH(
			    TRUE(),
			    Days < 7, 1,
			    Days < 14, 2,
			    Days < 21, 3,
			    Days < 31, 4,
			    Months < 3, 5,
			    Months < 6, 6,
			    Months < 9, 7,
			    Months < 12, 8,
			    Months < 24, 9,
			    Months < 36, 10,
			    Months < 60, 11,
			    Months < 120, 12,
			    13
			)
		formatString: 0
		summarizeBy: sum

	column 'Product Mapping Key' =
			
			VAR RawCode = TRIM ( COALESCE ( STG_WorkforceRoster[CostCenterCode], "" ) )
			RETURN IF ( RawCode = "", BLANK (), RIGHT ( RawCode, 4 ) )
		dataType: string
		isHidden
		summarizeBy: none

	column SiteKey = STG_WorkforceRoster[Location]
		dataType: string
		isHidden
		summarizeBy: none

	column HODKey =
			
			VAR HODValue = TRIM ( COALESCE ( STG_WorkforceRoster[HOD_Name], "" ) )
			RETURN IF ( HODValue = "", BLANK (), HODValue )
		dataType: string
		isHidden
		summarizeBy: none

	column LaborType
		dataType: string
		summarizeBy: none
		sourceColumn: LaborType

	column NationalityGroup
		dataType: string
		summarizeBy: none
		sourceColumn: NationalityGroup

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name


