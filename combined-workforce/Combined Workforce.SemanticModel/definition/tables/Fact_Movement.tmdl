table Fact_Movement

	column EventDate
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: EventDate

	column EventType
		dataType: string
		summarizeBy: none
		sourceColumn: EventType

	column EmployeeKey
		dataType: string
		summarizeBy: none
		sourceColumn: EmployeeKey

	column EmployeeCode_Source
		dataType: string
		summarizeBy: none
