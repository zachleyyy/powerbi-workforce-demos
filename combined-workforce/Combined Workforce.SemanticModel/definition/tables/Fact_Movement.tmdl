	column GradeKey
		dataType: string
		summarizeBy: none
		sourceColumn: GradeKey

	column SiteKey
		dataType: string
		summarizeBy: none
		sourceColumn: SiteKey

	column HODKey
		dataType: string
		summarizeBy: none
		sourceColumn: HODKey

	column GradeCode_Source
		dataType: string
		summarizeBy: none
		sourceColumn: GradeCode_Source

	column Location_Source
		dataType: string
		summarizeBy: none
		sourceColumn: Location_Source

	column HODName_Source
		dataType: string
		summarizeBy: none
		sourceColumn: HODName_Source

	column Department_Source
		dataType: string
