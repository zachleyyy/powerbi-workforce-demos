table Dim_HOD

	column HODKey
		dataType: string
		summarizeBy: none
		sourceColumn: HODKey

	column HODCode
		dataType: string
		summarizeBy: none
		sourceColumn: HODCode

	column HODName
		dataType: string
		summarizeBy: none
		sourceColumn: HODName


	partition Dim_HOD = m
		mode: import
		source =
			#table(type table [#"HODKey" = text, #"HODCode" = text, #"HODName" = text], {
				{"Demo Lead 1", "H1", "Demo Lead 1"},
				{"Demo Lead 2", "H2", "Demo Lead 2"},
				{"Demo Lead 3", "H3", "Demo Lead 3"}
			})
