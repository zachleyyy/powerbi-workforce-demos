		sourceColumn: Product Line
		summarizeBy: none

	column Product
		dataType: string
		sourceColumn: Product
		summarizeBy: none

	column DateOfBirth
		dataType: dateTime
		sourceColumn: DateOfBirth
		formatString: Long Date
		summarizeBy: none

	column TerminationReason
		dataType: string
		sourceColumn: TerminationReason
		summarizeBy: none

	column AssignmentNumber
