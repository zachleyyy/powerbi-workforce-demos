table Audit_Data

	measure 'Highest Joiners Month' =
			VAR _T =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            SUMMARIZE(ALLSELECTED('Dim_Date'), 'Dim_Date'[FiscalMonthLabel], 'Dim_Date'[FiscalMonthSort]),
			            "_Joiners", [Joiners]
			        ),
			        [_Joiners], DESC,
			        'Dim_Date'[FiscalMonthSort], ASC
			    )
			RETURN CONCATENATEX(_T, 'Dim_Date'[FiscalMonthLabel])
		formatString: General
		displayFolder: Insights

	measure 'Highest Terminations Month' =
			VAR _T =
			    TOPN(
			        1,
			        ADDCOLUMNS(
			            SUMMARIZE(ALLSELECTED('Dim_Date'), 'Dim_Date'[FiscalMonthLabel], 'Dim_Date'[FiscalMonthSort]),
			            "_Terms", [Terminations]
			        ),
			        [_Terms], DESC,
			        'Dim_Date'[FiscalMonthSort], ASC
			    )
			RETURN CONCATENATEX(_T, 'Dim_Date'[FiscalMonthLabel])
		formatString: General
		displayFolder: Insights

	measure 'Key Insights' = "Synthetic workforce demo"
		formatString: General
		displayFolder: Insights

	measure 'Largest Location' = VAR _T = TOPN(1, ADDCOLUMNS(ALLSELECTED('Audit_Data'[Location]), "_HC", [Ending Headcount]), [_HC], DESC, 'Audit_Data'[Location], ASC) RETURN CONCATENATEX(_T, 'Audit_Data'[Location])
		formatString: General
		displayFolder: Insights

	measure 'Largest Location HC' = MAXX(TOPN(1, ADDCOLUMNS(ALLSELECTED('Audit_Data'[Location]), "_HC", [Ending Headcount]), [_HC], DESC), [_HC])
		formatString: #,0
		displayFolder: Insights

	measure '% of Total HC' = DIVIDE([Ending Headcount], CALCULATE([Ending Headcount], REMOVEFILTERS('Audit_Data'[Location], 'Audit_Data'[HOD], 'Audit_Data'[Manager], 'Audit_Data'[Supervisor])))
		formatString: 0.0%
		displayFolder: KPIs

	measure 'Beginning Headcount' =
			VAR _HasDateContext =
			    ISFILTERED('Dim_Date'[Date])
			    || ISFILTERED('Dim_Date'[FiscalMonthLabel])
			    || ISFILTERED('Dim_Date'[FiscalQuarterLabel])
			    || ISFILTERED('Dim_Date'[FiscalYearLabel])
			    || ISFILTERED('Dim_Date'[FiscalWeekLabel])
			    || ISFILTERED('Dim_Date'[MonthLabel])
			    || ISFILTERED('Dim_Date'[CalendarYear])
			VAR _StartDate =
			    IF(
			        _HasDateContext,
			        MIN('Dim_Date'[Date]),
			        CALCULATE(
			            MIN('Audit_Data'[PeriodStart]),
			            REMOVEFILTERS('Dim_Date'),
			            REMOVEFILTERS('Audit_Data'[PeriodStart], 'Audit_Data'[PeriodEnd], 'Audit_Data'[Period], 'Audit_Data'[PeriodSort], 'Audit_Data'[Movement])
			        )
			    )
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Audit_Data'[PersonNumber]),
			    CROSSFILTER('Audit_Data'[PeriodStart], 'Dim_Date'[Date], NONE),
			    REMOVEFILTERS('Audit_Data'[Movement], 'Audit_Data'[Period], 'Audit_Data'[PeriodSort], 'Audit_Data'[PeriodStart], 'Audit_Data'[PeriodEnd]),
			    FILTER(
			        ALL('Audit_Data'[HireDate], 'Audit_Data'[TerminationDate]),
			        NOT ISBLANK('Audit_Data'[HireDate])
			            && 'Audit_Data'[HireDate] < _StartDate
			            && (ISBLANK('Audit_Data'[TerminationDate]) || 'Audit_Data'[TerminationDate] >= _StartDate)
			    )
			)
		formatString: #,0
		displayFolder: KPIs

	measure 'Contingent Worker Headcount' = CALCULATE([Ending Headcount], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: KPIs

	measure 'CW % of Total' = DIVIDE([Contingent Worker Headcount], [Ending Headcount])
		formatString: 0.0%
		displayFolder: KPIs

	measure 'Employee % of Total' = DIVIDE([Employee Headcount], [Ending Headcount])
		formatString: 0.0%
		displayFolder: KPIs

	measure 'Employee Headcount' = CALCULATE([Ending Headcount], KEEPFILTERS('Audit_Data'[Employee Type] = "Employee"))
		formatString: #,0
		displayFolder: KPIs

	measure 'Ending Headcount' =
			VAR _HasDateContext =
			    ISFILTERED('Dim_Date'[Date])
			    || ISFILTERED('Dim_Date'[FiscalMonthLabel])
			    || ISFILTERED('Dim_Date'[FiscalQuarterLabel])
			    || ISFILTERED('Dim_Date'[FiscalYearLabel])
			    || ISFILTERED('Dim_Date'[FiscalWeekLabel])
			    || ISFILTERED('Dim_Date'[MonthLabel])
			    || ISFILTERED('Dim_Date'[CalendarYear])
			VAR _SnapshotDate =
			    CALCULATE(MAX('Audit_Data'[SnapshotDate]), REMOVEFILTERS('Dim_Date'))
			VAR _CandidateEnd =
			    IF(
			        _HasDateContext,
			        MAX('Dim_Date'[Date]),
			        CALCULATE(
			            MAX('Audit_Data'[PeriodEnd]),
			            REMOVEFILTERS('Dim_Date'),
			            REMOVEFILTERS('Audit_Data'[PeriodStart], 'Audit_Data'[PeriodEnd], 'Audit_Data'[Period], 'Audit_Data'[PeriodSort], 'Audit_Data'[Movement])
			        )
			    )
			VAR _EndDate = MIN(_CandidateEnd, _SnapshotDate)
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('Audit_Data'[PersonNumber]),
			    CROSSFILTER('Audit_Data'[PeriodStart], 'Dim_Date'[Date], NONE),
			    REMOVEFILTERS('Audit_Data'[Movement], 'Audit_Data'[Period], 'Audit_Data'[PeriodSort], 'Audit_Data'[PeriodStart], 'Audit_Data'[PeriodEnd]),
			    FILTER(
			        ALL('Audit_Data'[HireDate], 'Audit_Data'[TerminationDate]),
			        NOT ISBLANK('Audit_Data'[HireDate])
			            && 'Audit_Data'[HireDate] <= _EndDate
			            && (ISBLANK('Audit_Data'[TerminationDate]) || 'Audit_Data'[TerminationDate] > _EndDate)
			    )
			)
		formatString: #,0
		displayFolder: KPIs

	measure 'HC Change % vs Previous Period' = DIVIDE([HC Change vs Previous Period], [HC Previous Period])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: KPIs

	measure 'HC Change vs Previous Period' = [Ending Headcount] - [HC Previous Period]
		formatString: +#,0;-#,0;0
		displayFolder: KPIs

	measure 'HC Previous Period' =
			VAR _HasDateContext =
			    ISFILTERED('Dim_Date'[Date])
			    || ISFILTERED('Dim_Date'[FiscalMonthLabel])
			    || ISFILTERED('Dim_Date'[FiscalQuarterLabel])
			    || ISFILTERED('Dim_Date'[FiscalYearLabel])
			    || ISFILTERED('Dim_Date'[FiscalWeekLabel])
			    || ISFILTERED('Dim_Date'[MonthLabel])
			    || ISFILTERED('Dim_Date'[CalendarYear])
			VAR _SnapshotDate = CALCULATE(MAX('Audit_Data'[SnapshotDate]), REMOVEFILTERS('Dim_Date'))
			VAR _CurrentSort =
			    IF(
			        _HasDateContext,
			        MAX('Dim_Date'[FiscalMonthSort]),
			        CALCULATE(
			            MAX('Dim_Date'[FiscalMonthSort]),
			            FILTER(ALL('Dim_Date'), 'Dim_Date'[Date] = _SnapshotDate)
			        )
			    )
			VAR _PreviousSort =
			    CALCULATE(
			        MAX('Dim_Date'[FiscalMonthSort]),
			        FILTER(ALL('Dim_Date'), 'Dim_Date'[FiscalMonthSort] < _CurrentSort)
			    )
			RETURN
			CALCULATE(
			    [Ending Headcount],
			    REMOVEFILTERS('Dim_Date'),
			    'Dim_Date'[FiscalMonthSort] = _PreviousSort
			)
		formatString: 0
		displayFolder: KPIs

	measure Joiners =
			CALCULATE(
			    DISTINCTCOUNT('Audit_Data'[PersonNumber]),
			    KEEPFILTERS('Audit_Data'[Movement] = "Hire"),
			    CROSSFILTER('Audit_Data'[PeriodStart], 'Dim_Date'[Date], NONE),
			    USERELATIONSHIP('Audit_Data'[HireDate], 'Dim_Date'[Date])
			)
		formatString: #,0
		displayFolder: KPIs

	measure 'Net HC Change' = [Joiners] - [Terminations]
		formatString: #,0;-#,0;0
		displayFolder: KPIs

	measure 'Net HC Change %' = DIVIDE([Net HC Change], [Beginning Headcount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPIs

	measure Terminations =
			CALCULATE(
			    DISTINCTCOUNT('Audit_Data'[PersonNumber]),
			    KEEPFILTERS('Audit_Data'[Movement] = "Exit"),
			    CROSSFILTER('Audit_Data'[PeriodStart], 'Dim_Date'[Date], NONE),
			    USERELATIONSHIP('Audit_Data'[TerminationDate], 'Dim_Date'[Date])
			)
		formatString: #,0
		displayFolder: KPIs

	measure 'CW Joiners' = CALCULATE([Joiners], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Vendor Analysis

	measure 'CW Net Change' = [CW Joiners] - [CW Terminations]
		formatString: +#,0;-#,0;0
		displayFolder: Vendor Analysis

	measure 'CW Terminations' = CALCULATE([Terminations], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Vendor Analysis

	measure 'Header Info' = "Synthetic workforce demo"
		formatString: General
		displayFolder: Attrition Review

	measure 'Termination Rate %' =
			
			DIVIDE(
			    [Terminations],
			    [Ending Headcount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: KPIs

	measure 'Joiner Rate %' =
			
			DIVIDE(
			    [Joiners],
			    [Ending Headcount],
			    0
			)
		displayFolder: KPIs

	measure 'Average Headcount' = DIVIDE([Beginning Headcount] + [Ending Headcount], 2)
		formatString: #,0.0
		displayFolder: Attrition

	measure 'Attrition Eligible Exits' =
			CALCULATE(
			    [Terminations],
			    KEEPFILTERS('Audit_Data'[IsVerifiedInternalConversion] <> TRUE())
			)
		formatString: #,0
		displayFolder: Attrition

	measure 'Verified Conversion Events' =
			CALCULATE(
			    DISTINCTCOUNT('Audit_Data'[EmploymentEventKey]),
			    KEEPFILTERS('Audit_Data'[Movement] = "Exit"),
			    KEEPFILTERS('Audit_Data'[IsVerifiedInternalConversion] = TRUE()),
			    CROSSFILTER('Audit_Data'[PeriodStart], 'Dim_Date'[Date], NONE),
			    USERELATIONSHIP('Audit_Data'[TerminationDate], 'Dim_Date'[Date])
			)
		formatString: #,0
		displayFolder: Attrition

	measure 'Conversion Events Requiring Review' =
			CALCULATE(
			    DISTINCTCOUNT('Audit_Data'[EmploymentEventKey]),
			    KEEPFILTERS('Audit_Data'[Movement] = "Exit"),
			    KEEPFILTERS('Audit_Data'[NeedsConversionReview] = TRUE()),
			    CROSSFILTER('Audit_Data'[PeriodStart], 'Dim_Date'[Date], NONE),
			    USERELATIONSHIP('Audit_Data'[TerminationDate], 'Dim_Date'[Date])
			)
		formatString: #,0
		displayFolder: Attrition

	measure 'Employee Attrition Eligible Exits' = CALCULATE([Attrition Eligible Exits], KEEPFILTERS('Audit_Data'[Employee Type] = "Employee"))
		formatString: #,0
		displayFolder: Attrition

	measure 'CW Attrition Eligible Exits' = CALCULATE([Attrition Eligible Exits], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Attrition

	measure 'Attrition Exit Share %' = DIVIDE([Attrition Eligible Exits], CALCULATE([Attrition Eligible Exits], REMOVEFILTERS('Audit_Data'[TerminationReason])))
		formatString: 0.0%
		displayFolder: Attrition

	measure 'Attrition Rate' = DIVIDE([Attrition Eligible Exits], [Average Headcount])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Employee Terminations' = CALCULATE([Terminations], KEEPFILTERS('Audit_Data'[Employee Type] = "Employee"))
		formatString: #,0
		displayFolder: Attrition

	measure 'Employee Attrition Rate' = CALCULATE([Attrition Rate], KEEPFILTERS('Audit_Data'[Employee Type] = "Employee"))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'CW Attrition Rate' = CALCULATE([Attrition Rate], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Termination Share %' = DIVIDE([Terminations], CALCULATE([Terminations], REMOVEFILTERS('Audit_Data'[TerminationReason])))
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Fiscal Beginning Headcount' = [Beginning Headcount]
		formatString: #,0
		displayFolder: Attrition

	measure 'Fiscal Ending Headcount' = [Ending Headcount]
		formatString: #,0
		displayFolder: Attrition

	measure 'Fiscal Terminations' = [Terminations]
		formatString: #,0
		displayFolder: Attrition

	measure 'Fiscal Average Headcount' = [Average Headcount]
		formatString: #,0.0
		displayFolder: Attrition

	measure 'Fiscal Attrition Rate' = [Attrition Rate]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Fiscal Employee Attrition Rate' = [Employee Attrition Rate]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Fiscal CW Attrition Rate' = [CW Attrition Rate]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Fiscal Termination Share %' = [Termination Share %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Attrition

	measure 'Fiscal Joiners' = [Joiners]
		formatString: #,0
		displayFolder: Fiscal KPIs

	measure 'Fiscal Net HC Change' = [Net HC Change]
		formatString: +#,0;-#,0;0
		displayFolder: Fiscal KPIs

	measure 'Fiscal Net HC Change %' = [Net HC Change %]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Fiscal KPIs

	measure 'Fiscal Joiner Rate %' = [Joiner Rate %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Fiscal KPIs

	measure 'Fiscal Termination Rate %' = [Termination Rate %]
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Fiscal KPIs

	measure 'Fiscal Employee Headcount' = [Employee Headcount]
		formatString: #,0
		displayFolder: Fiscal KPIs

	measure 'Fiscal Contingent Worker Headcount' = [Contingent Worker Headcount]
		formatString: #,0
		displayFolder: Fiscal KPIs

	measure 'Fiscal Employee % of Total' = [Employee % of Total]
		formatString: 0.0%
		displayFolder: Fiscal KPIs

	measure 'Fiscal CW % of Total' = [CW % of Total]
		formatString: 0.0%
		displayFolder: Fiscal KPIs

	measure 'Fiscal % of Total HC' = [% of Total HC]
		formatString: 0.0%
		displayFolder: Fiscal KPIs

	measure 'Fiscal CW Joiners' = [CW Joiners]
		formatString: #,0
		displayFolder: Vendor Analysis

	measure 'Fiscal CW Terminations' = [CW Terminations]
		formatString: #,0
		displayFolder: Vendor Analysis

	measure 'Fiscal CW Net Change' = [CW Net Change]
		formatString: +#,0;-#,0;0
		displayFolder: Vendor Analysis

	measure 'Reviewed Rate' =
			VAR A = [Average Headcount]
			RETURN IF(A > 0, DIVIDE(COALESCE([Attrition Eligible Exits], 0), A))
		formatString: 0.0%
		displayFolder: Attrition Review

	measure 'Reviewed Opening HC' = COALESCE([Beginning Headcount], 0)
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Reviewed Closing HC' = COALESCE([Ending Headcount], 0)
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Reviewed Average HC' = COALESCE([Average Headcount], 0)
		formatString: #,0.0
		displayFolder: Attrition Review

	measure 'Reviewed Eligible Exits' = COALESCE([Attrition Eligible Exits], 0)
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Reviewed Conversion Events' = COALESCE([Verified Conversion Events], 0)
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Reviewed Review Events' = COALESCE([Conversion Events Requiring Review], 0)
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Vendor Opening HC' = CALCULATE([Reviewed Opening HC], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Vendor Closing HC' = CALCULATE([Reviewed Closing HC], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Vendor Average HC' = CALCULATE([Reviewed Average HC], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0.0
		displayFolder: Attrition Review

	measure 'Vendor Eligible Exits' = CALCULATE([Reviewed Eligible Exits], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Vendor Attrition Rate' = CALCULATE([Reviewed Rate], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: 0.0%
		displayFolder: Attrition Review

	measure 'Vendor Conversion Review' = CALCULATE([Reviewed Review Events], KEEPFILTERS('Audit_Data'[Employee Type] = "Contingent Worker"))
		formatString: #,0
		displayFolder: Attrition Review

	measure 'Attrition Period Label' = "Synthetic workforce demo"
		formatString: General
		displayFolder: Attrition Review

	measure 'Movement Arithmetic' = [Beginning Headcount] + [Joiners] - [Terminations]
		formatString: #,0
		displayFolder: Data Quality

	measure 'Movement Residual' = [Ending Headcount] - [Movement Arithmetic]
		formatString: #,0
		displayFolder: Data Quality

	measure 'Movement Reconciliation Note' = "Synthetic workforce demo"
		formatString: General
		displayFolder: Data Quality

	measure 'Repeated Event Movement Rows' =
			COUNTROWS('Audit_Data') - COUNTROWS(SUMMARIZE('Audit_Data',
			    'Audit_Data'[PeriodStart], 'Audit_Data'[Movement], 'Audit_Data'[EmploymentEventKey]))
		formatString: #,0
		displayFolder: Data Quality

	measure 'Hierarchy Selection Context' = "Synthetic workforce demo"
		formatString: General
		displayFolder: Hierarchy Selection

	measure 'Unassigned HOD Closing HC' = COALESCE(CALCULATE([Ending Headcount], KEEPFILTERS('Audit_Data'[HOD] = BLANK())), 0)
		formatString: #,0
		displayFolder: Hierarchy Selection

	measure 'Unassigned Manager Closing HC' = COALESCE(CALCULATE([Ending Headcount], KEEPFILTERS('Audit_Data'[Manager] = BLANK())), 0)
		formatString: #,0
		displayFolder: Hierarchy Selection

	measure 'Unassigned Supervisor Closing HC' = COALESCE(CALCULATE([Ending Headcount], KEEPFILTERS('Audit_Data'[Supervisor] = BLANK())), 0)
		formatString: #,0
		displayFolder: Hierarchy Selection

	column Movement
		dataType: string
		sourceColumn: Movement
		summarizeBy: none

	column Period
		dataType: string
		sourceColumn: Period
		summarizeBy: none
		sortByColumn: PeriodSort

	column PeriodSort
		dataType: int64
		sourceColumn: PeriodSort
		formatString: 0
		summarizeBy: sum

	column PeriodStart
		dataType: dateTime
		sourceColumn: PeriodStart
		formatString: Long Date
		summarizeBy: none

	column PeriodEnd
		dataType: dateTime
		sourceColumn: PeriodEnd
		formatString: Long Date
		summarizeBy: none

	column PersonNumber
		dataType: string
		sourceColumn: PersonNumber
		summarizeBy: none

	column HireDate
		dataType: dateTime
		sourceColumn: HireDate
		formatString: Long Date
		summarizeBy: none

	column TerminationDate
		dataType: dateTime
		sourceColumn: TerminationDate
		formatString: Long Date
		summarizeBy: none

	column Location
		dataType: string
		sourceColumn: Location
		summarizeBy: none

	column HOD
		dataType: string
		sourceColumn: HOD
		summarizeBy: none

	column Manager
		dataType: string
		sourceColumn: Manager
		summarizeBy: none

	column Supervisor
		dataType: string
		sourceColumn: Supervisor
		summarizeBy: none

	column 'Employee Type'
		dataType: string
		sourceColumn: Employee Type
		summarizeBy: none

	column Gender
		dataType: string
		sourceColumn: Gender
		summarizeBy: none

	column Vendor
		dataType: string
		sourceColumn: Vendor
		summarizeBy: none

	column Nationality
		dataType: string
		sourceColumn: Nationality
		summarizeBy: none

	column SnapshotDate
		dataType: dateTime
		sourceColumn: SnapshotDate
		formatString: Long Date
		summarizeBy: none

	column SourceFile
		dataType: string
		sourceColumn: SourceFile
		summarizeBy: none

	column 'Product Line'
		dataType: string
		sourceColumn: Product Line
		summarizeBy: none

	column 'Nationality Group'
		dataType: string
		sourceColumn: Nationality Group
		summarizeBy: none

	column DateOfBirth
		dataType: dateTime
		sourceColumn: DateOfBirth
		formatString: Long Date
		summarizeBy: none

	column TerminationReason
		dataType: string
		sourceColumn: TerminationReason
		summarizeBy: none

	column 'Age Band'
		dataType: string
		sourceColumn: Age Band
		summarizeBy: none
		sortByColumn: 'Age Band Sort'

	column 'Age Band Sort'
		dataType: int64
		sourceColumn: Age Band Sort
		formatString: 0
		summarizeBy: none

	column 'Tenure Band'
		dataType: string
		sourceColumn: Tenure Band
		summarizeBy: none
		sortByColumn: 'Tenure Band Sort'

	column 'Tenure Band Sort'
		dataType: int64
		sourceColumn: Tenure Band Sort
		formatString: 0
		summarizeBy: none

	column AssignmentNumber
		dataType: string
		sourceColumn: AssignmentNumber
		summarizeBy: none

	column EmploymentEventKey
		dataType: string
		sourceColumn: EmploymentEventKey
		isHidden
		summarizeBy: none

	column ConversionReviewStatus
		dataType: string
		sourceColumn: ConversionReviewStatus
		summarizeBy: none

	column IsVerifiedInternalConversion
		dataType: boolean
		sourceColumn: IsVerifiedInternalConversion
		summarizeBy: none

	column NeedsConversionReview
		dataType: boolean
		sourceColumn: NeedsConversionReview
		summarizeBy: none

	column SuccessorAssignmentNumber
		dataType: string
		sourceColumn: SuccessorAssignmentNumber
		summarizeBy: none

	column 'Attrition Vendor'
		dataType: string
		sourceColumn: Attrition Vendor
		summarizeBy: none

	column 'Attrition Reason Label'
		dataType: string
		sourceColumn: Attrition Reason Label
		summarizeBy: none

	partition Audit_Data = m
