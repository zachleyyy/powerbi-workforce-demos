table Dim_HOD_Latest
	column HODKey
		dataType: string
		summarizeBy: none
		sourceColumn: HODKey

	column HODName
		dataType: string
		summarizeBy: none
		sourceColumn: HODName

	partition Dim_HOD_Latest = m
		mode: import
		source =
			#table(type table [#"HODKey" = nullable text, #"HODName" = nullable text], {
				{"TEAM-01", "TEAM-01"},
				{"TEAM-02", "TEAM-02"},
				{"TEAM-03", "TEAM-03"},
				{"TEAM-04", "TEAM-04"}
			})

