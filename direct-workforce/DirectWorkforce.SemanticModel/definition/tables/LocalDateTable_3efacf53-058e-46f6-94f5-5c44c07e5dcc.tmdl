table LocalDateTable_3efacf53-058e-46f6-94f5-5c44c07e5dcc
	isHidden
	showAsVariationsOnly
	column Date
		dataType: dateTime
		isHidden
		formatString: General Date
		dataCategory: PaddedDateTableDates
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column Year = YEAR([Date])
		dataType: int64
		isHidden
		formatString: 0
		dataCategory: Years
		summarizeBy: none

	column MonthNo = MONTH([Date])
		dataType: int64
		isHidden
		formatString: 0
		dataCategory: MonthOfYear
		summarizeBy: none

	column Month = FORMAT([Date], "MMMM")
		dataType: string
		isHidden
		dataCategory: Months
		summarizeBy: none
		sortByColumn: MonthNo

	column QuarterNo = INT(([MonthNo] + 2) / 3)
		dataType: int64
		isHidden
		formatString: 0
		dataCategory: QuarterOfYear
		summarizeBy: none

	column Quarter = "Qtr " & [QuarterNo]
		dataType: string
		isHidden
		dataCategory: Quarters
		summarizeBy: none
		sortByColumn: QuarterNo

	column Day = DAY([Date])
		dataType: int64
		isHidden
		formatString: 0
		dataCategory: DayOfMonth
		summarizeBy: none

	hierarchy 'Date Hierarchy'
		level Year
			column: Year

		level Quarter
			column: Quarter

		level Month
			column: Month

		level Day
			column: Day

	partition LocalDateTable_3efacf53-058e-46f6-94f5-5c44c07e5dcc = calculated
		mode: import
		source = Calendar(Date(Year(MIN('Fact_HCSnapshot'[TerminationDate_Source])), 1, 1), Date(Year(MAX('Fact_HCSnapshot'[TerminationDate_Source])), 12, 31))

