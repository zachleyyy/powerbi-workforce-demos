table Fact_RequiredHC_OLD
	column Date
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: Date

	column SiteKey
		dataType: string
		summarizeBy: none
		sourceColumn: SiteKey

	column RequirementArea_Source
		dataType: string
		summarizeBy: none
		sourceColumn: RequirementArea_Source

	column SourceQuarter
		dataType: string
		summarizeBy: none
		sourceColumn: SourceQuarter

	column FiscalQuarter
		dataType: string
		summarizeBy: none
		sourceColumn: FiscalQuarter

	column RequiredHC
		dataType: double
		summarizeBy: sum
		sourceColumn: RequiredHC

	column SourceWorkbook
		dataType: string
		summarizeBy: none
		sourceColumn: SourceWorkbook

	column SourceSheet
		dataType: string
		summarizeBy: none
		sourceColumn: SourceSheet

	column SourceRow
		dataType: int64
		formatString: 0
		summarizeBy: sum
		sourceColumn: SourceRow

	column HODMappingStatus
		dataType: string
		summarizeBy: none
		sourceColumn: HODMappingStatus

