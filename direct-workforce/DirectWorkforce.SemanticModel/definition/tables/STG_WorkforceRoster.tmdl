		summarizeBy: none
		sourceColumn: Manager_Name

	column HOD_Name
		dataType: string
		summarizeBy: none
		sourceColumn: HOD_Name

	column 'Date modified'
		dataType: dateTime
		formatString: General Date
		summarizeBy: none
		sourceColumn: Date modified

		variation Variation
			isDefault
			relationship: 146df952-ec09-4b62-b39e-935f13c75c70
			defaultHierarchy: LocalDateTable_2a3ed600-e690-4b68-8a01-b8b5fb48f528.'Date Hierarchy'

	column AssignmentNumber
		dataType: string
		summarizeBy: none
