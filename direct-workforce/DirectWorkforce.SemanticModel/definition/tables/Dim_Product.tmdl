				{"Demo Unit", "0002", "Demo Product 03", "DEMO-03", "Demo Area", "Demo Product Line 01", "Demo Product 03", "Synthetic demonstration"},
				{"Demo Unit", "0003", "Demo Product 04", "DEMO-04", "Demo Area", "Demo Product Line 02", "Demo Product 04", "Synthetic demonstration"},
