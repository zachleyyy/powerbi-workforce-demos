	column 'Oracle Project Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Oracle Project Code

	column 'Oracle Project Code Description'
		dataType: string
		summarizeBy: none
		sourceColumn: Oracle Project Code Description

	column 'Resource Code'
		dataType: string
		summarizeBy: none
		sourceColumn: Resource Code

	column AREA
		dataType: string
		summarizeBy: none
		sourceColumn: AREA

	column 'PRODUCT Line'
		dataType: string
		summarizeBy: none
		sourceColumn: PRODUCT Line

	column PRODUCT
		dataType: string
		summarizeBy: none
		sourceColumn: PRODUCT

	column 'Source Note'
		dataType: string
		summarizeBy: none
		sourceColumn: Source Note

	partition Dim_Product = m
		mode: import
		source =
			#table(type table [#"Item BU" = nullable text, #"Oracle Project Code" = nullable text, #"Oracle Project Code Description" = nullable text, #"Resource Code" = nullable text, #"AREA" = nullable text, #"PRODUCT Line" = nullable text, #"PRODUCT" = nullable text, #"Source Note" = nullable text], {
